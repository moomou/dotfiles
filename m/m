import glob
import importlib
import inspect
import json
import logging.config
import os
import pathlib as pl

import m_base
import simple_argparse as sa
from constant import M_ROOT

DEPENDENCIES_BY_MODULE = {
    "audio": (
        "deco==0.5.2",
        "h5py",
        "librosa==0.10.2",
        "matplotlib",
        "pydub==0.20.0",
        "scipy>=0.19.0",
        "tqdm==4.43.0",
    ),
    "dedup": ("tqdm==4.43.0",),
    "docker": ("pyyaml",),
    "pipe": (
        "deco==0.5.2",
        "librosa==0.10.2",
        "redis",
        "requests",
        "tqdm==4.43.0",
    ),
    "shell": ("deco==0.5.2", "requests"),
    "www": ("jinja2==2.11.3", "markdown2", "pyyaml", "requests"),
    "zarr": ("zarr==2.4.0",),
}
DEPENDENCIES_READY_ENV = "_M_DEPENDENCIES_READY"


def ensure_command_dependencies(command):
    dependencies = DEPENDENCIES_BY_MODULE.get(command.partition(".")[0], ())
    ready_value = "\n".join(dependencies)
    if not dependencies or os.environ.get(DEPENDENCIES_READY_ENV) == ready_value:
        return

    import sys

    env = os.environ.copy()
    env[DEPENDENCIES_READY_ENV] = ready_value

    uv_args = ["uv", "run"]
    for dependency in dependencies:
        uv_args.extend(("--with", dependency))
    uv_args.extend(("--script", os.path.realpath(__file__), *sys.argv[1:]))
    os.execvpe(uv_args[0], uv_args, env)


with open(os.path.join(M_ROOT, "./log.conf")) as conf:
    logging.config.dictConfig(json.load(conf))
    logger = logging.getLogger()


class M2:
    def list_m_modules(self):
        cmds = [
            (pl.Path(cmd).name[2:], slice(-3) if cmd.endswith(".py") else slice(999))
            for cmd in glob.glob(f"{M_ROOT}/m_*")
        ]
        cmds = [cmd[s] for (cmd, s) in cmds]
        return cmds

    def exec_m_module_command(self, m_module, sub_cmds, *args, **kwargs):
        logger.debug(f"exec_m_module_command: {args}, {kwargs}")

        assert (
            len(sub_cmds) == 1
        ), f"Only first level cmd supported for now; got {sub_cmds}"
        cmd = sub_cmds[0]
        getattr(m_module, cmd)(*args, **kwargs)

    def exec_m_modules(self, cmd, *args, **kwargs):
        cmd, *subcommands = cmd.split(".")
        cmds = self.list_m_modules()

        # cmd exist
        if cmd in cmds:
            m_module_name = f"m_{cmd}"

            cmd_module = importlib.import_module(m_module_name)
            clsmembers = inspect.getmembers(
                cmd_module,
                lambda cls: inspect.isclass(cls)
                and cls.__module__ == m_module_name
                and issubclass(cls, m_base.Base),
            )

            assert (
                len(clsmembers) == 1
            ), f"{m_module_name} exports more than 1 m_base.Base. Found {clsmembers}"

            _, cls = clsmembers[0]

            if not subcommands:
                cls().print_cmds()
            else:
                self.exec_m_module_command(cls(), subcommands, *args, **kwargs)
        else:
            logger.error(f"{cmd} not found")

    def print_m_modules(self):
        sa.print_commands(self.list_m_modules())

    def noop(self):
        """
        Noop method for speed tests
        """
        return

    def update(self, pip_install_only=False):
        """
        Updates the m tool. uv installs command dependencies on demand.
        """
        import fs_util
        import git_util

        if pip_install_only:
            logger.info("dependencies are managed by uv and installed on demand")
            return

        logger.info("updating m tool by rebasing...")
        with fs_util.Cwd(M_ROOT):
            git_util.stash()
            git_util.rebase()
            git_util.stash_pop()
            _, stdout, _ = git_util.log("--pretty=oneline --abbrev-commit -1")
            logger.info("m updated:: %s", stdout.decode("utf-8").strip())


if __name__ == "__main__":
    import atexit
    import gc
    import sys

    gc.set_threshold(0)
    exit_status = [0]

    def fast_exit():
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(exit_status[0])

    # Skip CPython's remaining finalization after later atexit callbacks while
    # preserving the command's actual exit status.
    atexit.register(fast_exit)

    try:
        pos, named = sa.parse(sys.argv[1:])
        if not pos:
            sys.exit(M2().print_m_modules())
        elif pos[0] == "update":
            M2().update(*pos[1:], **named)
        else:
            ensure_command_dependencies(pos[0])
            M2().exec_m_modules(pos[0], *pos[1:], **named)
    except SystemExit as exc:
        if exc.code is None:
            exit_status[0] = 0
        elif isinstance(exc.code, int):
            exit_status[0] = exc.code
        else:
            exit_status[0] = 1
        raise
    except KeyboardInterrupt:
        exit_status[0] = 130
        raise
    except BaseException:
        exit_status[0] = 1
        raise
