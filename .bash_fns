# https://gist.github.com/wadey/1140259
tab-color() {
    local colors=('e6194b' '3cb44b' 'ffe119' '4363d8' 'f58231' '911eb4' '46f0f0' 'f032e6' 'bcf60c' 'fabebe' '008080' 'e6beff' '9a6324' 'fffac8' '800000' 'aaffc3' '808000' 'ffd8b1' '000075' '808080' 'ffffff' '000000')
    local host directory key color red green blue char
    local hash=5381 code i
    local LC_ALL=C

    if (( $# == 3 )); then
        red=$1
        green=$2
        blue=$3
    else
        host=${1:-$HOSTNAME}
        [[ -n "$host" ]] || host=$(hostname)
        directory=${2:-${PWD##*/}}
        [[ -n "$directory" ]] || directory=/
        key="$host:$directory"

        # DJB2 avoids spawning a checksum process on every invocation.
        for ((i = 0; i < ${#key}; i++)); do
            char=${key:i:1}
            printf -v code '%d' "'$char"
            hash=$(( ((hash << 5) + hash + code) & 0x7fffffff ))
        done

        color=${colors[$((hash % ${#colors[@]}))]}
        red=$((16#${color:0:2}))
        green=$((16#${color:2:2}))
        blue=$((16#${color:4:2}))
    fi

    printf '\033]6;1;bg;red;brightness;%s\a\033]6;1;bg;green;brightness;%s\a\033]6;1;bg;blue;brightness;%s\a' \
        "$red" "$green" "$blue"
}
tab-reset() {
    echo -ne "\033]6;1;bg;*;default\a"
}
# Change the color of the tab when using SSH
# reset the color after the connection closes
color-ssh() {
    if [[ -n "$ITERM_SESSION_ID" ]]; then
        trap "tab-reset" RETURN
        if [[ "$*" =~ "production|ec2-.*compute-1" ]]; then
            tab-color 255 0 0
        else
            tab-color 255 145 117
        fi
    fi
    ssh $*
}
alias ssh=color-ssh

ginit() {
    git init
    lan=$(echo $1 | python3 -c "print raw_input().capitalize()")
    wget -q https://raw.githubusercontent.com/github/gitignore/master/${lan}.gitignore -O .gitignore
    git add .
    git ci -am 'init with .gitignore'
}

function BashPrompt() {
    local success='ヽ(・∀・)ﾉ '

    printf '\033[31m%s\033(B\033[m[%s].' "$success" "$PROMPT_PREFIX"
}

# pyenv dark magic
function initpyenv() {
    $(command -v pyenv >/dev/null 2>&1) || return
    eval "$(pyenv init -)"
    eval "$(pyenv virtualenv-init -)"
}

# ranger color
function color-ranger() {
    if [[ -n "$ITERM_SESSION_ID" ]]; then
        trap "tab-reset" RETURN
        tab-color 213 95 192
    fi
    ranger $*
}
alias ranger=color-ranger

# git rebase
function rebase() {
    branch=${1:-master}
    git pull --rebase origin $branch && git sub update --init --jobs 4
}

# watch and list changed files
function list-change() {
    fswatch --batch-marker=EOF -xn . | while read file event; do
        echo $file $event
        if [ $file = "EOF" ]; then
            echo TRIGGER
        fi
    done
}

# copied & modified from https://stackoverflow.com/questions/20649783/pause-a-running-script-in-mac-terminal-and-then-resume-later
suspend-proc() {
    [[ -z $1 || $1 == '-h' || $1 == '--help' ]] && {
        echo "Usage: $FUNCNAME scriptFileName ..."$'\n'"Suspends the specified bash/sh script(s)."
        return $((${#1} == 0))
    }
    local ec=0
    for p in "$@"; do
        pkill -STOP -nf "$p" &&
            echo "'$1' suspended." ||
            {
                ec=$?
                echo "ERROR: process not found: '$p'" 1>&2
            }
    done
    return $ec
}
resume-proc() {
    [[ -z $1 || $1 == '-h' || $1 == '--help' ]] && {
        echo "Usage: $FUNCNAME scriptFileName ..."$'\n'"Resumes the specified bash/sh script(s)."
        return $((${#1} == 0))
    }
    local ec=0
    for p in "$@"; do
        pkill -CONT -nf "$p" &&
            echo "'$1' resumed." ||
            {
                ec=$?
                echo "ERROR: process not found: '$p'" 1>&2
            }
    done
    return $ec
}

function keychain_pwd() {
    security find-generic-password -s $1 -w
}

# copied from https://superuser.com/questions/456803/create-ram-disk-mount-to-specific-folder-in-osx
function mk_osx_ramdisk() {
    ramfs_size_mb=2100
    mount_point=/tmp/rdisk

    ramfs_size_sectors=$((${ramfs_size_mb} * 1024 * 1024 / 512))
    ramdisk_dev=$(hdid -nomount ram://${ramfs_size_sectors})

    newfs_hfs -v 'ram disk' ${ramdisk_dev}
    mkdir -p ${mount_point}
    mount -o noatime -t hfs ${ramdisk_dev} ${mount_point}

    echo
    echo "remove with:"
    echo "  umount ${mount_point}"
    echo "  diskutil eject ${ramdisk_dev}"
}

function copy2() {
    declare BUFFER=${1:-$(</dev/stdin)}
    echo "$BUFFER" > /tmp/.shell_copy2_buffer
}

function paste2() {
    if [ ! -f /tmp/.shell_copy2_buffer ]; then
        echo
    else
        cat /tmp/.shell_copy2_buffer
    fi
}

function proxy-socks() {
    HOST=$1
    echo proxying $HOST on port 9093
    ssh -D 9093 $HOST
}
